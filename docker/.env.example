# Copy to docker/.env before building, so bind-mounted files created inside the
# containers are owned by your host user instead of root:
#   echo "UID=$(id -u)" > docker/.env && echo "GID=$(id -g)" >> docker/.env
UID=1000
GID=1000
# Numeric GID that owns /dev/dri/renderD* on the host (`stat -c %g /dev/dri/renderD128`).
RENDER_GID=110
LIBGL_ALWAYS_SOFTWARE=1
